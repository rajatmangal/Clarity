{
  "name": "clarity-finance",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4310",
    "build": "next build",
    "start": "node scripts/start-server.mjs",
    "test": "node --test test/*.test.mjs",
    "start:server": "node scripts/start-server.mjs",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop": "npm run desktop:prepare && electron .",
    "desktop:run": "electron .",
    "desktop:pack": "npm run desktop:prepare && electron-builder --config desktop/build-config.cjs --dir --publish never",
    "desktop:mac": "npm run desktop:prepare && electron-builder --config desktop/build-config.cjs --mac --publish never",
    "desktop:windows": "npm run desktop:prepare && electron-builder --config desktop/build-config.cjs --win --publish never",
    "test:integration": "node --test test/server.integration.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "dayjs": "^1.11.23",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10"
  },
  "description": "See your spending. Plan your saving.",
  "author": "Clarity contributors",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "app.clarity.money",
    "productName": "Clarity",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "public/brand/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-runtime",
        "to": "runtime"
      },
      {
        "from": "build-runtime/node_modules",
        "to": "runtime/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.finance",
      "icon": "public/brand/clarity-1024.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/brand/clarity-256.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/rajatmangal/Clarity/releases/download/latest/",
        "channel": "latest"
      }
    ]
  }
}
