# Local browser mode: npm run build && npm start
OPENAI_API_KEY=
# Optional absolute path. The default is vault/ inside the configuration folder.
# VAULT_DIR=/absolute/path/to/your/money-vault
# Server/LAN mode: set all three, then use HTTPS through a reverse proxy for remote access.
# CLARITY_HOST=0.0.0.0
# CLARITY_ORIGIN=https://money.example.com
# CLARITY_PASSWORD=choose-a-long-unique-password
# Browser sign-in username: clarity
# PORT=4310
